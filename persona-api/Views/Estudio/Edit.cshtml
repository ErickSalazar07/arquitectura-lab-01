@model persona_api.Models.Entities.Estudio

<div class="container mt-4">

    <div class="card shadow p-4">

        <h1 class="mb-4">
            Editar Estudio
        </h1>

        <form asp-action="Edit" method="post">

            <input type="hidden" asp-for="IdProf" />
            <input type="hidden" asp-for="CcPer" />

            <div class="mb-3">

                <label class="form-label">
                    Fecha
                </label>

                <input asp-for="Fecha"
                       type="date"
                       class="form-control" />

            </div>

            <div class="mb-4">

                <label class="form-label">
                    Universidad
                </label>

                <input asp-for="Univer"
                       class="form-control" />

            </div>

            <div class="d-flex gap-2">

                <button type="submit"
                        class="btn btn-primary">

                    Actualizar

                </button>

                <a asp-action="Index"
                       class="btn btn-secondary">

                    Volver

                </a>

            </div>

        </form>

    </div>

</div>