@model persona_api.Models.Entities.Estudio

<div class="container mt-4">

    <div class="card shadow p-4">

        <h1 class="mb-4">
            Crear Estudio
        </h1>

        <form asp-action="Create" method="post">

            <div class="mb-3">

                <label class="form-label">
                    Profesión
                </label>

                <select asp-for="IdProf"
                        asp-items="ViewBag.Profesiones"
                        class="form-select">

                    <option value="">
                        Seleccione una profesión
                    </option>

                </select>

            </div>

            <div class="mb-3">

                <label class="form-label">
                    Persona
                </label>

                <select asp-for="CcPer"
                        asp-items="ViewBag.Personas"
                        class="form-select">

                    <option value="">
                        Seleccione una persona
                    </option>

                </select>

            </div>

            <div class="mb-3">

                <label class="form-label">
                    Fecha
                </label>

                <input asp-for="Fecha"
                       type="date"
                       class="form-control" />

            </div>

            <div class="mb-4">

                <label class="form-label">
                    Universidad
                </label>

                <input asp-for="Univer"
                       class="form-control" />

            </div>

            <div class="d-flex gap-2">

                <button type="submit"
                        class="btn btn-primary">

                    Guardar

                </button>

                <a asp-action="Index"
                       class="btn btn-secondary">

                    Volver

                </a>

            </div>

        </form>

    </div>

</div>