@model persona_api.Models.Entities.Estudio

<h1>Crear Estudio</h1>

<form asp-action="Create" method="post">

    <div>
        <label>Profesión</label>

        <select asp-for="IdProf"
                asp-items="ViewBag.Profesiones">

            <option value="">
                Seleccione una profesión
            </option>

        </select>
    </div>

    <div>
        <label>Persona</label>

        <select asp-for="CcPer"
                asp-items="ViewBag.Personas">

            <option value="">
                Seleccione una persona
            </option>

        </select>
    </div>

    <div>
        <label>Fecha</label>

        <input asp-for="Fecha"
               type="date" />
    </div>

    <div>
        <label>Universidad</label>

        <input asp-for="Univer" />
    </div>

    <button type="submit">
        Guardar
    </button>

</form>