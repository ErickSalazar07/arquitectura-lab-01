@model persona_api.Models.Entities.Profesion

<div class="container mt-4">

    <div class="card shadow p-4">

        <h1 class="mb-4">
            Editar Profesión
        </h1>

        <form asp-action="Edit" method="post">

            <input type="hidden" asp-for="Id" />

            <div class="mb-3">

                <label class="form-label">
                    Nombre
                </label>

                <input asp-for="Nom"
                       class="form-control" />

            </div>

            <div class="mb-4">

                <label class="form-label">
                    Descripción
                </label>

                <input asp-for="Des"
                       class="form-control" />

            </div>

            <div class="d-flex gap-2">

                <button type="submit"
                        class="btn btn-primary">

                    Actualizar

                </button>

                <a asp-action="Index"
                       class="btn btn-secondary">

                    Volver

                </a>

            </div>

        </form>

    </div>

</div>