@model List<persona_api.Models.Entities.Profesion>

<h1>Profesiones</h1>

<a asp-action="Create">Crear Nueva</a>

<table border="1">

    <thead>
        <tr>
            <th>ID</th>
            <th>Nombre</th>
            <th>Descripcion</th>
            <th>Acciones</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var item in Model)
        {
            <tr>

                <td>@item.Id</td>
                <td>@item.Nom</td>
                <td>@item.Des</td>

                <td>

                    <a asp-action="Edit"
                           asp-route-id="@item.Id">
                        Editar
                    </a>

                    |

                    <a asp-action="Delete"
                           asp-route-id="@item.Id">
                        Eliminar
                    </a>

                </td>

            </tr>
        }

    </tbody>

</table>