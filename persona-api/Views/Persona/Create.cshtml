@model persona_api.Models.Entities.Persona

<div class="container mt-4">

    <div class="card shadow p-4">

        <h1 class="mb-4">
            Crear Persona
        </h1>

        <form asp-action="Create" method="post">

            <div class="mb-3">

                <label class="form-label">
                    Cédula
                </label>

                <input asp-for="Cc"
                       class="form-control" />

            </div>

            <div class="mb-3">

                <label class="form-label">
                    Nombre
                </label>

                <input asp-for="Nombre"
                       class="form-control" />

            </div>

            <div class="mb-3">

                <label class="form-label">
                    Apellido
                </label>

                <input asp-for="Apellido"
                       class="form-control" />

            </div>

            <div class="mb-3">

                <label class="form-label">
                    Género
                </label>

                <select asp-for="Genero"
                        class="form-select">

                    <option value="">
                        -- Seleccione --
                    </option>

                    <option value="M">
                        Masculino
                    </option>

                    <option value="F">
                        Femenino
                    </option>

                </select>

            </div>

            <div class="mb-4">

                <label class="form-label">
                    Edad
                </label>

                <input asp-for="Edad"
                       class="form-control" />

            </div>

            <div class="d-flex gap-2">

                <button type="submit"
                        class="btn btn-primary">

                    Guardar

                </button>

                <a asp-action="Index"
                       class="btn btn-secondary">

                    Volver

                </a>

            </div>

        </form>

    </div>

</div>