@model persona_api.Models.Entities.Persona

<h1>Eliminar Persona</h1>

<p>¿Seguro que desea eliminar esta persona?</p>

<ul>
    <li>Cédula: @Model.Cc</li>
    <li>Nombre: @Model.Nombre @Model.Apellido</li>
    <li>Género: @Model.Genero</li>
    <li>Edad: @Model.Edad</li>
</ul>

<form asp-action="DeleteConfirmed" method="post">
    <input type="hidden" name="cc" value="@Model.Cc" />
    <button type="submit">Eliminar</button>
</form>