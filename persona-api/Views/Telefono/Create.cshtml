@model persona_api.Models.Entities.Telefono

<div class="container mt-4">

    <div class="card shadow p-4">

        <h1 class="mb-4">
            Crear Teléfono
        </h1>

        <form asp-action="Create" method="post">

            <div class="mb-3">

                <label class="form-label">
                    Número
                </label>

                <input asp-for="Num"
                       class="form-control" />

            </div>

            <div class="mb-3">

                <label class="form-label">
                    Operador
                </label>

                <input asp-for="Oper"
                       class="form-control" />

            </div>

            <div class="mb-4">

                <label class="form-label">
                    Dueño
                </label>

                <select asp-for="Duenio"
                        asp-items="ViewBag.Personas"
                        class="form-select">

                    <option value="">
                        Seleccione una persona
                    </option>

                </select>

            </div>

            <div class="d-flex gap-2">

                <button type="submit"
                        class="btn btn-primary">

                    Guardar

                </button>

                <a asp-action="Index"
                       class="btn btn-secondary">

                    Volver

                </a>

            </div>

        </form>

    </div>

</div>