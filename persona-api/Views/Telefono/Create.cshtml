@model persona_api.Models.Entities.Telefono

<h1>Crear Teléfono</h1>

<form asp-action="Create" method="post">

    <div>
        <label>Número</label>

        <input asp-for="Num" />
    </div>

    <div>
        <label>Operador</label>

        <input asp-for="Oper" />
    </div>

    <div>
        <label>Dueño</label>

        <select asp-for="Duenio"
                asp-items="ViewBag.Personas">

            <option value="">
                Seleccione una persona
            </option>

        </select>
    </div>

    <button type="submit">
        Guardar
    </button>

</form>