@model persona_api.Models.Entities.Telefono

<h1>Editar Teléfono</h1>

<form asp-action="Edit" method="post">

    <input type="hidden" asp-for="Num" />

    <div>
        <label>Operador</label>

        <input asp-for="Oper" />
    </div>

    <div>
        <label>Dueño</label>

        <select asp-for="Duenio"
                asp-items="ViewBag.Personas">

            <option value="">
                Seleccione una persona
            </option>

        </select>
    </div>

    <button type="submit">
        Actualizar
    </button>

</form>