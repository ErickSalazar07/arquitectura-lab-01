@model persona_api.Models.Entities.Telefono

<div class="container mt-4">

    <div class="card shadow p-4">

        <h1 class="text-danger mb-4">
            Eliminar Teléfono
        </h1>

        <div class="alert alert-warning">

            ¿Seguro que desea eliminar este teléfono?

        </div>

        <ul class="list-group mb-4">

            <li class="list-group-item">
                <strong>Número:</strong> @Model.Num
            </li>

            <li class="list-group-item">
                <strong>Operador:</strong> @Model.Oper
            </li>

            <li class="list-group-item">
                <strong>Dueño (CC):</strong> @Model.Duenio
            </li>

        </ul>

        <form asp-action="DeleteConfirmed" method="post">

            <input type="hidden"
                   name="num"
                   value="@Model.Num" />

            <div class="d-flex gap-2">

                <button type="submit"
                        class="btn btn-danger">

                    Eliminar

                </button>

                <a asp-action="Index"
                       class="btn btn-secondary">

                    Volver

                </a>

            </div>

        </form>

    </div>

</div>